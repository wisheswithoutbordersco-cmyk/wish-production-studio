FAL_KEY=your-fal-ai-key
OPENROUTER_API_KEY=sk-or-v1-your-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key
# Set a private value in Railway; access fails closed if neither variable is set.
OWNER_PASSWORD=
# APP_PASSWORD is accepted as a fallback when OWNER_PASSWORD is not set.
PORT=3000
NODE_ENV=production
